{
  "name": "downtube",
  "productName": "Downtube",
  "version": "0.1.0",
  "description": "YouTube video, müzik, playlist ve kanal indirici + offline oynatıcı",
  "main": "./out/main/index.js",
  "author": "minok",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "npm run build && playwright test",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
